{% comment %}
  Product Template Section — Maeven
  Inspired by getshapd.co product page layout:
  - 2-column gallery + info layout
  - Bundle & Save pricing
  - Color/Size variant pickers
  - Trust badges
{% endcomment %}

<section class="product-page">
  <div class="container product-page__inner">

    {%- comment -%} LEFT: Product Gallery {%- endcomment -%}
    <div class="product-gallery" id="product-gallery">
      <div class="product-gallery__main">
        {% if product.featured_image %}
          <img
            id="product-main-image"
            src="{{ product.featured_image | image_url: width: 1200 }}"
            alt="{{ product.featured_image.alt | default: product.title }}"
            width="1200"
            height="1600"
            loading="eager"
          >
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
      {% for image in product.images %}
        {% if forloop.index > 1 %}
          <div class="product-gallery__thumb{% if forloop.index == 2 %} active{% endif %}" data-image="{{ image | image_url: width: 1200 }}">
            <img
              src="{{ image | image_url: width: 400 }}"
              alt="{{ image.alt | default: product.title }}"
              width="400"
              height="400"
              loading="lazy"
            >
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {%- comment -%} RIGHT: Product Info {%- endcomment -%}
    <div class="product-info">

      <h1 class="product-info__title">{{ product.title }}</h1>

      <div class="product-info__price">
        {% if product.compare_at_price > product.price %}
          <span class="product-info__price-current product-info__price-current--sale">
            {{ product.price | money }}
          </span>
          <span class="product-info__price-compare">{{ product.compare_at_price | money }}</span>
        {% else %}
          <span class="product-info__price-current">{{ product.price | money }}</span>
        {% endif %}
      </div>

      {%- comment -%} Star rating placeholder {%- endcomment -%}
      {% if section.settings.show_rating %}
        <div class="stars" style="margin-bottom: 20px;">
          {% for i in (1..5) %}
            <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          {% endfor %}
          <span class="stars__count">({{ section.settings.review_count }} reviews)</span>
        </div>
      {% endif %}

      {%- comment -%} BUNDLE & SAVE {%- endcomment -%}
      {% if section.settings.enable_bundles %}
        <div class="bundle-section">
          <div class="bundle-section__title">{{ section.settings.bundle_heading }}</div>

          {% for block in section.blocks %}
            {% if block.type == 'bundle_tier' %}
              <div class="bundle-option{% if forloop.index == 2 %} active{% endif %}" data-price="{{ block.settings.price }}" {{ block.shopify_attributes }}>
                <div class="bundle-option__left">
                  <div class="bundle-option__radio"></div>
                  <span class="bundle-option__label">{{ block.settings.label }}</span>
                  {% if block.settings.save_text != blank %}
                    <span class="bundle-option__save-badge">{{ block.settings.save_text }}</span>
                  {% endif %}
                </div>
                <div class="bundle-option__right">
                  <div class="bundle-option__price">${{ block.settings.price }}</div>
                  {% if block.settings.compare_price != blank %}
                    <div class="bundle-option__compare">${{ block.settings.compare_price }}</div>
                  {% endif %}
                </div>
                {% if block.settings.badge != blank %}
                  <div class="bundle-option__badge">{{ block.settings.badge }}</div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {%- comment -%} VARIANT PICKERS {%- endcomment -%}
      {% unless product.has_only_default_variant %}
        <div class="product-variants">
          {%- for option in product.options_with_values -%}
            <div class="variant-group">
              <div class="variant-group__label">
                {{ option.name }}: <span>{{ option.selected_value }}</span>
              </div>

              {% if option.name == 'Color' or option.name == 'Colour' %}
                <div class="color-swatches">
                  {%- for value in option.values -%}
                    {%- assign color_handle = value | handleize -%}
                    <button
                      class="color-swatch{% if option.selected_value == value %} active{% endif %}"
                      data-color="{{ value }}"
                      style="background-color: {{ color_handle }};"
                      title="{{ value }}"
                      aria-label="{{ value }}"
                    ></button>
                  {%- endfor -%}
                </div>
              {% else %}
                <div class="size-options">
                  {%- for value in option.values -%}
                    <button
                      class="size-option{% if option.selected_value == value %} active{% endif %}"
                      data-value="{{ value }}"
                    >
                      {{ value }}
                    </button>
                  {%- endfor -%}
                </div>
              {% endif %}
            </div>
          {%- endfor -%}
        </div>
      {% endunless %}

      {%- comment -%} ADD TO CART {%- endcomment -%}
      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <div class="add-to-cart">
          <button type="submit" class="add-to-cart__btn"{% unless product.available %} disabled{% endunless %}>
            {% if product.available %}
              Add to cart – <span class="add-to-cart__price">{{ product.selected_or_first_available_variant.price | money }}</span>
            {% else %}
              Sold Out
            {% endif %}
          </button>
        </div>
      {% endform %}

      {%- comment -%} TRUST BADGES {%- endcomment -%}
      <div class="trust-badges">
        <div class="trust-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
          </svg>
          Free Shipping
        </div>
        <div class="trust-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
          </svg>
          30-Day Returns
        </div>
        <div class="trust-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          Secure Payment
        </div>
      </div>

      {%- comment -%} PRODUCT DESCRIPTION ACCORDION {%- endcomment -%}
      <div class="product-description">
        <div class="product-accordion">
          <button class="product-accordion__trigger open" type="button">
            Description
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="product-accordion__content open" style="max-height: 500px;">
            <div class="product-accordion__body">
              {{ product.description }}
            </div>
          </div>
        </div>

        {% for block in section.blocks %}
          {% if block.type == 'accordion' %}
            <div class="product-accordion" {{ block.shopify_attributes }}>
              <button class="product-accordion__trigger" type="button">
                {{ block.settings.heading }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <div class="product-accordion__content">
                <div class="product-accordion__body">
                  {{ block.settings.content }}
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count",
      "default": "128"
    },
    {
      "type": "checkbox",
      "id": "enable_bundles",
      "label": "Enable Bundle & Save",
      "default": true
    },
    {
      "type": "text",
      "id": "bundle_heading",
      "label": "Bundle heading",
      "default": "Bundle & Save"
    }
  ],
  "blocks": [
    {
      "type": "bundle_tier",
      "name": "Bundle Tier",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Buy 1"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "29.99"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare at price"
        },
        {
          "type": "text",
          "id": "save_text",
          "label": "Save badge text"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Corner badge (e.g. Most Bought)"
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion Tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shipping & Returns"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Free shipping on orders over $55. 30-day return policy.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Page",
      "blocks": [
        {
          "type": "bundle_tier",
          "settings": {
            "label": "Buy 1",
            "price": "29.99"
          }
        },
        {
          "type": "bundle_tier",
          "settings": {
            "label": "Buy 2",
            "price": "49.99",
            "compare_price": "59.98",
            "save_text": "You save 25%",
            "badge": "Most Bought"
          }
        },
        {
          "type": "bundle_tier",
          "settings": {
            "label": "Buy 3",
            "price": "59.99",
            "compare_price": "89.97",
            "save_text": "You save 42%",
            "badge": "Best Value"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "heading": "Shipping & Returns",
            "content": "<p>Free shipping on all orders over $55. Easy 30-day returns — no questions asked.</p>"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "heading": "Size Guide",
            "content": "<p>Please refer to our size chart to find your perfect fit. We recommend going with your usual size for the most comfortable fit.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
