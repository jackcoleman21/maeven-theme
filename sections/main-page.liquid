<section class="main-page" style="padding: 40px 0 80px;">
  <div class="container">
    <h1 style="font-size: 2rem; font-weight: 800; margin-bottom: 24px;">{{ page.title }}</h1>
    <div class="rte" style="font-size: 0.9375rem; line-height: 1.8; color: var(--color-text-light); max-width: 720px;">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
