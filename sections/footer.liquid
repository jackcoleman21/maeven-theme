<!-- ═══ Footer (Coral Canton style) ═══ -->
<footer class="ft-footer" id="shopify-section-footer">

  <!-- Accordion: Help & Support -->
  <div class="ft-accordion">
    <button class="ft-accordion__trigger" aria-expanded="false">
      <span>Help & Support</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    </button>
    <div class="ft-accordion__panel">
      <a href="/pages/contact">Contact Us</a>
      <a href="/policies/shipping-policy">Shipping Policy</a>
      <a href="/policies/refund-policy">Return Policy</a>
      <a href="/pages/faq">FAQ</a>
      <a href="/pages/track-your-order">Track Your Order</a>
    </div>
  </div>

  <!-- Accordion: Company -->
  <div class="ft-accordion">
    <button class="ft-accordion__trigger" aria-expanded="false">
      <span>COMPANY</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    </button>
    <div class="ft-accordion__panel">
      <a href="/pages/about-us">About Us</a>
      <a href="/policies/privacy-policy">Privacy Policy</a>
      <a href="/policies/terms-of-service">Terms of Service</a>
    </div>
  </div>

  <!-- Partners -->
  <div class="ft-partners">
    <h3 class="ft-partners__title">PARTNERS</h3>
    <div class="ft-partner-block">
      <strong>Affiliate/Retail Partnerships</strong>
      <p>Email: marketing@maevenclothing.com</p>
    </div>
    <div class="ft-partner-block">
      <strong>Wholesale</strong>
      <p>Email: wholesale@maevenclothing.com</p>
    </div>
    <div class="ft-partner-block">
      <strong>Influencer/Creator Partnership:</strong>
      <p>Email: marketing@maevenclothing.com</p>
    </div>
  </div>

