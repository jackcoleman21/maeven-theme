    </a>
  </div>

  <!-- Newsletter -->
  <div class="ft-accordion">
    <button class="ft-accordion__trigger" aria-expanded="false">
      <span>Sign Up to Newsletter</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    </button>
    <div class="ft-accordion__panel">
      <form method="post" action="/contact#footer-newsletter" class="ft-newsletter-form">
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="Enter your email" required class="ft-newsletter-input">
        <button type="submit" class="ft-newsletter-btn">Subscribe</button>
      </form>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="ft-bottom">
    <span>United States (USD $)</span>
    <span>© {{ 'now' | date: '%Y' }} Maeven® store. All rights reserved.</span>
  </div>

  <div class="ft-payments">
    {%- for type in shop.enabled_payment_types -%}
      {{ type | payment_type_svg_tag: class: 'ft-payment-icon' }}
    {%- endfor -%}
  </div>
</footer>

<style>
.ft-footer {
  background: #eee9e2;
  padding: 40px 20px 24px;
}
/* Accordions */
.ft-accordion {
  border-bottom: 1px solid rgba(0,0,0,0.1);
}
.ft-accordion__trigger {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 0;
  background: none;
  border: none;
  cursor: pointer;
  font-family: 'Inter', 'Instrument Sans', system-ui, sans-serif;
  font-size: 15px;
  font-weight: 700;
  color: #1a1a1a;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.ft-accordion__trigger svg {
  width: 18px;
  height: 18px;
  transition: transform 0.3s;
}
.ft-accordion__trigger[aria-expanded="true"] svg {
  transform: rotate(45deg);
}
.ft-accordion__panel {
  display: none;
  padding: 0 0 16px;
}
.ft-accordion__panel a {
  display: block;
  font-family: 'Inter', system-ui, sans-serif;
  font-size: 14px;
  color: #555;
  text-decoration: none;
  padding: 6px 0;
  transition: color 0.2s;
}
.ft-accordion__panel a:hover { color: #1a1a1a; }
/* Partners */
.ft-partners {
  padding: 24px 0;
  border-bottom: 1px solid rgba(0,0,0,0.1);
}
.ft-partners__title {
  font-family: 'Inter', 'Instrument Sans', system-ui, sans-serif;
  font-size: 15px;
  font-weight: 700;
  color: #1a1a1a;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin: 0 0 16px;
}
.ft-partner-block {
  margin-bottom: 14px;
}
.ft-partner-block strong {
  font-family: 'Inter', system-ui, sans-serif;
  font-size: 14px;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
  margin-bottom: 2px;
}
.ft-partner-block p {
  font-family: 'Inter', system-ui, sans-serif;
  font-size: 13px;
  color: #777;
  margin: 0;
}
/* Socials */
.ft-socials {
  display: flex;
  gap: 12px;
  padding: 20px 0;
}
.ft-socials a {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 1px solid rgba(0,0,0,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1a1a1a;
  transition: all 0.2s;
}
.ft-socials a:hover { background: #1a1a1a; color: #fff; border-color: #1a1a1a; }
.ft-socials svg { width: 18px; height: 18px; }
/* Newsletter form */
.ft-newsletter-form {
  display: flex;
  gap: 8px;
  max-width: 400px;
}
.ft-newsletter-input {
  flex: 1;
  padding: 10px 14px;
  border: 1px solid rgba(0,0,0,0.2);
  border-radius: 6px;
  font-size: 14px;
  font-family: 'Inter', system-ui, sans-serif;
  background: #fff;
}
.ft-newsletter-btn {
  padding: 10px 20px;
  background: #1a1a1a;
  color: #fff;
  border: none;
  border-radius: 6px;
  font-family: 'Inter', system-ui, sans-serif;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: opacity 0.2s;
}
.ft-newsletter-btn:hover { opacity: 0.8; }
/* Bottom */
.ft-bottom {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  justify-content: center;
  padding: 20px 0 8px;
  font-family: 'Inter', system-ui, sans-serif;
  font-size: 12px;
  color: #999;
}
.ft-payments {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 6px;
  padding: 8px 0 0;
}
.ft-payments img, .ft-payments svg, .ft-payment-icon { height: 24px; width: auto; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.ft-accordion__trigger').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var expanded = this.getAttribute('aria-expanded') === 'true';
      this.setAttribute('aria-expanded', !expanded);
      var panel = this.nextElementSibling;
      panel.style.display = expanded ? 'none' : 'block';
    });
  });
});
</script>

