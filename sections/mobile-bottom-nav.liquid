<!-- ═══ Mobile Sticky Bottom Nav (Coral Canton style) ═══ -->
<nav class="msn-bar" id="mobile-sticky-nav">
  <a href="/" class="msn-item msn-item--active">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
    </svg>
    <span>Home</span>
  </a>
  <a href="/account" class="msn-item">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
      <circle cx="12" cy="7" r="4"/>
    </svg>
    <span>Account</span>
  </a>
  <a href="/collections/all" class="msn-item">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
      <rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
    </svg>
    <span>Shop</span>
  </a>
  <a href="/cart" class="msn-item msn-item--cart">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
      <line x1="3" y1="6" x2="21" y2="6"/>
      <path d="M16 10a4 4 0 01-8 0"/>
    </svg>
    <span class="msn-cart-count">{{ cart.item_count }}</span>
    <span>Cart</span>
  </a>
</nav>

<style>
.msn-bar {
  display: none;
}
@media (max-width: 749px) {
  .msn-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    background: #fff;
    border-top: 1px solid rgba(0,0,0,0.08);
    display: flex;
    justify-content: space-around;
    padding: 8px 0 env(safe-area-inset-bottom, 4px);
    box-shadow: 0 -2px 12px rgba(0,0,0,0.06);
  }
}
.msn-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-decoration: none;
  color: #1a1a1a;
  font-family: 'Inter', system-ui, sans-serif;
  font-size: 10px;
  font-weight: 500;
  gap: 2px;
  position: relative;
}
.msn-item svg { width: 22px; height: 22px; }
.msn-cart-count {
  position: absolute;
  top: -4px;
  right: -6px;
  width: 16px;
  height: 16px;
  background: #c0392b;
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
</style>

{% schema %}
{
  "name": "Mobile Bottom Nav",
  "settings": [],
  "presets": [{ "name": "Mobile Bottom Nav" }]
}
{% endschema %}
