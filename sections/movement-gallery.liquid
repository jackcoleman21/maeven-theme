<style>
.mg-section {
  padding: 48px 0 32px;
  background: #f9f6f2;
  text-align: center;
}
.mg-heading {
  font-family: 'Inter', system-ui, sans-serif;
  font-size: 28px;
  font-weight: 700;
  color: #1a1a1a;
  margin: 0 0 8px;
}
.mg-subheading {
  font-family: 'Inter', system-ui, sans-serif;
  font-size: 14px;
  font-weight: 400;
  color: #777;
  margin: 0 auto 24px;
  max-width: 500px;
  line-height: 1.5;
}
.mg-carousel { overflow: hidden; padding: 0 12px; }
.mg-track {
  display: flex;
  gap: 10px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.mg-track::-webkit-scrollbar { display: none; }
.mg-card {
  flex: 0 0 calc(50% - 5px);
  scroll-snap-align: start;
  border-radius: 12px;
  overflow: hidden;
  background: #eae6e0;
}
.mg-card img {
  width: 100%;
  aspect-ratio: 3/4;
  object-fit: cover;
  display: block;
}
.mg-dots {
  display: flex;
  justify-content: center;
  gap: 6px;
  padding: 16px 0 0;
}
.mg-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #ccc;
  border: none;
  cursor: pointer;
  padding: 0;
  transition: all 0.2s;
}
.mg-dot.active { background: #1a1a1a; }
@media (min-width: 750px) {
  .mg-card { flex: 0 0 calc(33.333% - 7px); }
  .mg-heading { font-size: 34px; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var sectionId = '{{ section.id }}';
  var track = document.getElementById('mgTrack-' + sectionId);
  var dotsWrap = document.getElementById('mgDots-' + sectionId);
  if (!track || !dotsWrap) return;
  var cards = track.querySelectorAll('.mg-card');
  var cpp = window.innerWidth >= 750 ? 3 : 2;
  var total = Math.ceil(cards.length / cpp);
  for (var i = 0; i < total; i++) {
    var dot = document.createElement('button');
    dot.className = 'mg-dot' + (i === 0 ? ' active' : '');
    dot.dataset.page = i;
    dot.addEventListener('click', function() {
      var pg = parseInt(this.dataset.page);
      cards[pg * cpp]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
      dotsWrap.querySelectorAll('.mg-dot').forEach(function(d, j) { d.classList.toggle('active', j === pg); });
    });
    dotsWrap.appendChild(dot);
  }
  track.addEventListener('scroll', function() {
    var pg = Math.round(track.scrollLeft / (cards[0].offsetWidth + 10) / cpp);
    dotsWrap.querySelectorAll('.mg-dot').forEach(function(d, j) { d.classList.toggle('active', j === pg); });
  });
});
</script>

