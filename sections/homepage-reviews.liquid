<!-- ═══ Homepage Testimonials (Coral Canton 1:1) ═══ -->
<section class="ht-section" id="homepage-testimonials">
  <h2 class="ht-heading">Let customers speak for us</h2>
  <div class="ht-stars">
    {%- for i in (1..5) -%}<svg viewBox="0 0 24 24" class="ht-star"><path d="M12 2l2.94 6.48L22 9.27l-5.04 4.58L18.18 21 12 17.27 5.82 21l1.22-7.15L2 9.27l7.06-.79L12 2z"/></svg>{%- endfor -%}
  </div>
  <p class="ht-count">from {{ section.settings.review_count | default: '2090' }} reviews <svg class="ht-verified" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" fill="none" stroke="#27ae60" stroke-width="2"/></svg></p>

  <div class="ht-carousel">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
      <div class="ht-card" {{ block.shopify_attributes }}>
        {%- if block.settings.image -%}
        <div class="ht-card__media">
          <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.author }}" loading="lazy" width="200" height="280">
        </div>
        {%- elsif block.settings.image_url != blank -%}
        <div class="ht-card__media">
          <img src="{{ block.settings.image_url }}" alt="{{ block.settings.author }}" loading="lazy" width="200" height="280">
        </div>
        {%- endif -%}
        <div class="ht-card__content">
          <div class="ht-card__stars">
            {%- for i in (1..5) -%}<svg viewBox="0 0 24 24" class="ht-star-sm"><path d="M12 2l2.94 6.48L22 9.27l-5.04 4.58L18.18 21 12 17.27 5.82 21l1.22-7.15L2 9.27l7.06-.79L12 2z"/></svg>{%- endfor -%}
          </div>
          <p class="ht-card__text">{{ block.settings.text }}</p>
          {%- if block.settings.author != blank -%}
            <span class="ht-card__author">{{ block.settings.author }}</span>
          {%- endif -%}
        </div>
      </div>
      {%- endfor -%}
    {%- else -%}
      <!-- Hardcoded CC reviews -->
      <div class="ht-card">
        <div class="ht-card__media"><img src="https://judgeme.imgix.net/coral-canton/1765362775__1765362768091-img_4197__original.jpeg?width=400" alt="Review" loading="lazy"></div>
        <div class="ht-card__content">
          <div class="ht-card__stars">{%- for i in (1..5) -%}<svg viewBox="0 0 24 24" class="ht-star-sm"><path d="M12 2l2.94 6.48L22 9.27l-5.04 4.58L18.18 21 12 17.27 5.82 21l1.22-7.15L2 9.27l7.06-.79L12 2z"/></svg>{%- endfor -%}</div>
          <p class="ht-card__text">evenbetter than dfyne</p>
          <span class="ht-card__author">Anonymous</span>
        </div>
      </div>
      <div class="ht-card">
        <div class="ht-card__content">
          <div class="ht-card__stars">{%- for i in (1..5) -%}<svg viewBox="0 0 24 24" class="ht-star-sm"><path d="M12 2l2.94 6.48L22 9.27l-5.04 4.58L18.18 21 12 17.27 5.82 21l1.22-7.15L2 9.27l7.06-.79L12 2z"/></svg>{%- endfor -%}</div>
          <p class="ht-card__text">perfect i love them so much</p>
          <span class="ht-card__author">Anonymous</span>
        </div>
      </div>
      <div class="ht-card">
        <div class="ht-card__content">
          <div class="ht-card__stars">{%- for i in (1..5) -%}<svg viewBox="0 0 24 24" class="ht-star-sm"><path d="M12 2l2.94 6.48L22 9.27l-5.04 4.58L18.18 21 12 17.27 5.82 21l1.22-7.15L2 9.27l7.06-.79L12 2z"/></svg>{%- endfor -%}</div>
          <p class="ht-card__text">Hugs in the right places without being too tight. I love the structure and shape it gives.</p>
          <span class="ht-card__author">Anonymous</span>
        </div>
      </div>
      <div class="ht-card">
        <div class="ht-card__content">
          <div class="ht-card__stars">{%- for i in (1..5) -%}<svg viewBox="0 0 24 24" class="ht-star-sm"><path d="M12 2l2.94 6.48L22 9.27l-5.04 4.58L18.18 21 12 17.27 5.82 21l1.22-7.15L2 9.27l7.06-.79L12 2z"/></svg>{%- endfor -%}</div>
          <p class="ht-card__text">They look chic with sneakers and a tee — feels like a complete outfit. Fits true to size for me.</p>
          <span class="ht-card__author">Anonymous</span>
        </div>
      </div>
      <div class="ht-card">
        <div class="ht-card__content">
          <div class="ht-card__stars">{%- for i in (1..5) -%}<svg viewBox="0 0 24 24" class="ht-star-sm"><path d="M12 2l2.94 6.48L22 9.27l-5.04 4.58L18.18 21 12 17.27 5.82 21l1.22-7.15L2 9.27l7.06-.79L12 2z"/></svg>{%- endfor -%}</div>
          <p class="ht-card__text">The fabric and finish feel premium — looks like a much pricier pair of leggings.</p>
          <span class="ht-card__author">Anonymous</span>
        </div>
      </div>
      <div class="ht-card">
        <div class="ht-card__content">
          <div class="ht-card__stars">{%- for i in (1..5) -%}<svg viewBox="0 0 24 24" class="ht-star-sm"><path d="M12 2l2.94 6.48L22 9.27l-5.04 4.58L18.18 21 12 17.27 5.82 21l1.22-7.15L2 9.27l7.06-.79L12 2z"/></svg>{%- endfor -%}</div>
          <p class="ht-card__text">So many pretty colors. I want one of each! I got compliments!</p>
          <span class="ht-card__author">Anonymous</span>
        </div>
      </div>
      <div class="ht-card">
        <div class="ht-card__content">
          <div class="ht-card__stars">{%- for i in (1..5) -%}<svg viewBox="0 0 24 24" class="ht-star-sm"><path d="M12 2l2.94 6.48L22 9.27l-5.04 4.58L18.18 21 12 17.27 5.82 21l1.22-7.15L2 9.27l7.06-.79L12 2z"/></svg>{%- endfor -%}</div>
          <p class="ht-card__text">I'm 5'9" and these have the perfect length — not too short. I got compliments!</p>
          <span class="ht-card__author">Anonymous</span>
        </div>
      </div>
      <div class="ht-card">
        <div class="ht-card__content">
          <div class="ht-card__stars">{%- for i in (1..5) -%}<svg viewBox="0 0 24 24" class="ht-star-sm"><path d="M12 2l2.94 6.48L22 9.27l-5.04 4.58L18.18 21 12 17.27 5.82 21l1.22-7.15L2 9.27l7.06-.79L12 2z"/></svg>{%- endfor -%}</div>
          <p class="ht-card__text">Comfortable, flattering, and durable. Highly recommend.</p>
          <span class="ht-card__author">Anonymous</span>
        </div>
      </div>
      <div class="ht-card">
        <div class="ht-card__content">
          <div class="ht-card__stars">{%- for i in (1..5) -%}<svg viewBox="0 0 24 24" class="ht-star-sm"><path d="M12 2l2.94 6.48L22 9.27l-5.04 4.58L18.18 21 12 17.27 5.82 21l1.22-7.15L2 9.27l7.06-.79L12 2z"/></svg>{%- endfor -%}</div>
          <p class="ht-card__text">I wear them straight from the gym to coffee — they look great with a cropped jacket.</p>
          <span class="ht-card__author">Anonymous</span>
        </div>
      </div>
      <div class="ht-card">
        <div class="ht-card__content">
          <div class="ht-card__stars">{%- for i in (1..5) -%}<svg viewBox="0 0 24 24" class="ht-star-sm"><path d="M12 2l2.94 6.48L22 9.27l-5.04 4.58L18.18 21 12 17.27 5.82 21l1.22-7.15L2 9.27l7.06-.79L12 2z"/></svg>{%- endfor -%}</div>
          <p class="ht-card__text">If you're between sizes, go true to size. They hug perfectly without being restrictive.</p>
          <span class="ht-card__author">Anonymous</span>
        </div>
      </div>
    {%- endif -%}
  </div>

  <div class="ht-nav">
    <button class="ht-nav-btn ht-prev" aria-label="Previous">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <button class="ht-nav-btn ht-next" aria-label="Next">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg>
    </button>
  </div>
</section>

<style>
.ht-section {
  padding: 60px 0 48px;
  text-align: center;
  background: #f9f6f2;
  position: relative;
}
.ht-heading {
  font-family: 'Inter', 'Instrument Sans', system-ui, sans-serif;
  font-size: 30px;
  font-weight: 700;
  color: #1a1a1a;
  margin: 0 0 8px;
}
.ht-stars { display: flex; justify-content: center; gap: 3px; margin-bottom: 4px; }
.ht-star { width: 22px; height: 22px; fill: #e8836b; }
.ht-count {
  font-family: 'Inter', system-ui, sans-serif;
  font-size: 14px;
  color: #777;
  margin: 0 0 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
}
.ht-verified { width: 18px; height: 18px; }
.ht-carousel {
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  gap: 20px;
  padding: 0 20px 20px;
}
.ht-carousel::-webkit-scrollbar { display: none; }
.ht-card {
  flex: 0 0 calc(100% - 40px);
  scroll-snap-align: center;
  display: flex;
  gap: 20px;
  align-items: flex-start;
  text-align: left;
}
.ht-card__media {
  flex: 0 0 200px;
  border-radius: 10px;
  overflow: hidden;
}
.ht-card__media img {
  width: 100%;
  aspect-ratio: 3/4;
  object-fit: cover;
  display: block;
}
.ht-card__content {
  flex: 1;
  padding-top: 8px;
}
.ht-card__stars { display: flex; gap: 2px; margin-bottom: 10px; }
.ht-star-sm { width: 18px; height: 18px; fill: #e8836b; }
.ht-card__text {
  font-family: 'Inter', system-ui, sans-serif;
  font-size: 15px;
  line-height: 1.6;
  color: #333;
  margin: 0 0 12px;
}
.ht-card__author {
  font-family: 'Inter', system-ui, sans-serif;
  font-size: 13px;
  color: #999;
  font-weight: 500;
}
.ht-nav {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin-top: 16px;
}
.ht-nav-btn {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 1px solid #ddd;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s;
}
.ht-nav-btn:hover { background: #1a1a1a; border-color: #1a1a1a; }
.ht-nav-btn:hover svg { color: #fff; }
.ht-nav-btn svg { width: 20px; height: 20px; color: #1a1a1a; }
@media (min-width: 750px) {
  .ht-card { flex: 0 0 calc(50% - 10px); }
  .ht-heading { font-size: 36px; }
}
@media (max-width: 749px) {
  .ht-card { flex-direction: column; align-items: center; text-align: center; }
  .ht-card__media { flex: 0 0 auto; width: 200px; }
  .ht-card__stars { justify-content: center; }
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var carousel = document.querySelector('.ht-carousel');
    if (!carousel) return;
    var cards = carousel.querySelectorAll('.ht-card');
    var idx = 0;
    document.querySelector('.ht-prev').addEventListener('click', function() {
      idx = Math.max(0, idx - 1);
      cards[idx].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
    });
    document.querySelector('.ht-next').addEventListener('click', function() {
      idx = Math.min(cards.length - 1, idx + 1);
      cards[idx].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
    });
  });
</script>

{% schema %}
{
  "name": "Homepage Reviews",
  "settings": [
    { "type": "text", "id": "review_count", "label": "Total review count", "default": "2090" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Reviewer photo" },
        { "type": "text", "id": "image_url", "label": "Reviewer photo URL (fallback)" },
        { "type": "text", "id": "text", "label": "Review text" },
        { "type": "text", "id": "author", "label": "Author name" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Homepage Reviews" }]
}
{% endschema %}
