/* Vendor */
.cc-vendor {
  font-size:14px;
  color:#888;
  margin-bottom:4px;
  text-decoration:underline;
  text-underline-offset:2px;
}

/* Title */
.cc-product-title {
  font-family:'Inter', system-ui, sans-serif;
  font-size:28px;
  font-weight:700;
  line-height:1.2;
  margin:0 0 16px;
}

/* Price */
.cc-price-row {
  display:flex;
  align-items:baseline;
  gap:12px;
  margin-bottom:28px;
}
.cc-sale-price {
  font-size:28px;
  font-weight:700;
  color:#E53E3E;
}
.cc-compare-price {
  font-size:24px;
  font-weight:400;
  color:#aaa;
  text-decoration:line-through;
}

/* ═══ Color Swatches (Image-based carousel) ═══ */
.cc-color-section {
  margin-bottom:28px;
  overflow:hidden;
  max-width:100%;
}
.cc-color-label {
  font-size:12px;
  font-weight:600;
  letter-spacing:0.08em;
  text-transform:uppercase;
  color:#555;
  margin-bottom:12px;
}
.cc-color-swatches-wrap {
  display:flex;
  align-items:center;
  gap:0;
  position:relative;
  overflow:hidden;
  max-width:100%;
}
.cc-swatch-arrow {
  width:36px;
  height:36px;
  border-radius:50%;
  background:rgba(255,255,255,0.9);
  border:1px solid #e0e0e0;
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-shrink:0;
  z-index:2;
  transition:all 0.2s;
}
.cc-swatch-arrow:hover { background:#f0f0f0; border-color:#ccc; }
.cc-swatch-arrow svg { width:16px; height:16px; color:#333; }
.cc-color-swatches-track {
  display:flex;
  gap:8px;
  overflow-x:auto;
  scroll-behavior:smooth;
  padding:4px 8px;
  flex:1;
  min-width:0;
  max-width:100%;
  -ms-overflow-style:none;
  scrollbar-width:none;
}
.cc-color-swatches-track::-webkit-scrollbar { display:none; }
.cc-color-swatch {
  flex-shrink:0;
  width:90px;
  cursor:pointer;
  border:none;
  background:none;
  padding:0;
  text-align:center;
  transition:all 0.2s;
}
.cc-swatch-img {
  width:90px;
  height:110px;
  border-radius:4px;
  overflow:hidden;
  border:2px solid transparent;
  transition:border-color 0.2s;
  background:#f5f5f5;
  position:relative;
}
.cc-color-swatch.active .cc-swatch-img,
.cc-color-swatch:hover .cc-swatch-img {
  border-color:#1a1a1a;
}
.cc-swatch-img img {
  width:100%;
  height:100%;
  object-fit:cover;
}
.cc-swatch-placeholder {
  width:100%;
  height:100%;
  background:#ddd;
}
.cc-swatch-name {
  display:block;
  font-size:9px;
  font-weight:600;
  letter-spacing:0.06em;
  color:#888;
  margin-top:4px;
  padding:2px 4px;
  border-radius:3px;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.cc-swatch-name.active,
.cc-color-swatch.active .cc-swatch-name {
  background:#1a1a1a;
  color:#fff;
}
/* Out of stock swatch */
.cc-color-swatch.oos { opacity:.45; position:relative; pointer-events:auto; }
.cc-color-swatch.oos .cc-swatch-img::after {
  content:''; position:absolute; top:0; left:0; right:0; bottom:0;
  background:linear-gradient(135deg, transparent 45%, rgba(0,0,0,.35) 45%, rgba(0,0,0,.35) 55%, transparent 55%);
}

/* ═══ Size Selector ═══ */
.cc-size-section {
  margin-bottom:20px;
}
.cc-size-label {
  font-size:14px;
  color:#555;
  margin-bottom:12px;
}
.cc-size-label strong {
  color:#1a1a1a;
  font-weight:700;
}
.cc-size-options {
  display:flex;
  gap:8px;
  flex-wrap:wrap;
}
.cc-size-btn {
  min-width:56px;
  height:44px;
  padding:0 16px;
  border:1px solid #ddd;
  border-radius:4px;
  background:#fff;
  font-family:'Inter', sans-serif;
  font-size:14px;
  font-weight:500;
  color:#1a1a1a;
  cursor:pointer;
  transition:all 0.2s;
}
.cc-size-btn:hover { border-color:#1a1a1a; }
.cc-size-btn.active {
  background:#1a1a1a;
  color:#fff;
  border-color:#1a1a1a;
}

/* Meta links */
.cc-meta-links {
  display:flex;
  gap:24px;
  margin-bottom:24px;
  padding-top:4px;
}
.cc-meta-link {
  display:flex;
  align-items:center;
  gap:6px;
  background:none;
  border:none;
  font-family:'Inter', sans-serif;
  font-size:13px;
  color:#555;
  cursor:pointer;
  padding:0;
}
.cc-meta-link:hover { color:#1a1a1a; }
.cc-meta-link svg { width:18px; height:18px; }

/* ═══ Quantity + ATC ═══ */
.cc-atc-row {
  display:flex;
  gap:12px;
  margin-bottom:12px;
}
.cc-qty-selector {
  display:flex;
  align-items:center;
  border:1px solid #ddd;
  border-radius:30px;
  overflow:hidden;
  flex-shrink:0;
}
.cc-qty-btn {
  width:44px;
  height:52px;
  background:none;
  border:none;
  font-size:18px;
  color:#1a1a1a;
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  transition:background 0.2s;
}
.cc-qty-btn:hover { background:#f5f5f5; }
.cc-qty-input {
  width:40px;
  height:52px;
  border:none;
  text-align:center;
  font-family:'Inter', sans-serif;
  font-size:16px;
  font-weight:500;
  background:none;
  -moz-appearance:textfield;
  outline:none;
}
.cc-qty-input::-webkit-outer-spin-button,
.cc-qty-input::-webkit-inner-spin-button { -webkit-appearance:none; margin:0; }
.cc-atc-form { flex:1; }
.cc-atc-btn {
  width:100%;
  height:52px;
  background:#1a1a1a;
  color:#fff;
  border:none;
  border-radius:30px;
  font-family:'Inter', sans-serif;
  font-size:15px;
  font-weight:600;
  cursor:pointer;
  transition:all 0.3s;
  letter-spacing:0.02em;
}
.cc-atc-btn:hover { background:#333; }
.cc-atc-btn:disabled { opacity:0.5; cursor:not-allowed; }

/* Dynamic Checkout */
.cc-dynamic-checkout { display:none; }
.cc-shopify-payment-button { margin-bottom:16px; }
.cc-shopify-payment-button .shopify-payment-button__button { border-radius:30px !important; height:52px !important; }
.cc-shopify-payment-button .shopify-payment-button__button--unbranded {
  background:#5A31F4 !important;
  border-radius:30px !important;
}
.cc-shopify-payment-button .shopify-payment-button__more-options {
  background:#1a1a1a !important;
  color:#fff !important;
  border-radius:30px !important;
  height:52px !important;
  font-family:'Inter', sans-serif !important;
  font-size:14px !important;
}

/* Stock message */
.cc-stock-msg {
  display:flex;
  align-items:center;
  gap:8px;
  font-size:13px;
  font-weight:500;
  color:#E53E3E;
  margin-bottom:28px;
  padding:10px 0;
}
.cc-stock-msg svg { width:18px; height:18px; flex-shrink:0; }

/* Payment Trust Icons */
.cc-trust-payments { display:flex; align-items:center; gap:8px; flex-wrap:wrap; padding:0 0 20px; }
.cc-trust-payments svg, .cc-pay-icon { height:22px; width:auto; }

/* Cross-sell */
.cc-cross-sell { padding:20px 0 24px; border-top:1px solid var(--border-light,#eee); }
.cc-cross-title { font-family:'Playfair Display',serif; font-size:16px; font-weight:600; margin:0 0 14px; }
.cc-cross-cards { display:flex; gap:12px; }
.cc-cross-card { display:flex; align-items:center; gap:12px; padding:12px; border:1px solid var(--border-light,#eee); border-radius:10px; text-decoration:none; color:inherit; flex:1; transition:border-color .2s,box-shadow .2s; }
.cc-cross-card:hover { border-color:var(--noir,#1a1a1a); box-shadow:0 2px 12px rgba(0,0,0,0.08); }
.cc-cross-img { width:56px; height:56px; border-radius:8px; overflow:hidden; flex-shrink:0; background:#f5f5f5; }
.cc-cross-img img { width:100%; height:100%; object-fit:cover; }
.cc-cross-info { display:flex; flex-direction:column; gap:2px; }
.cc-cross-name { font-size:13px; font-weight:600; line-height:1.3; }
.cc-cross-price { font-size:13px; font-weight:700; color:var(--noir,#1a1a1a); }
.cc-cross-compare { font-size:11px; color:var(--pierre,#999); text-decoration:line-through; }
@media(max-width:480px){ .cc-cross-cards { flex-direction:column; } }

/* ═══ Accordions ═══ */
.cc-accordions {
  border-top:1px solid #e5e5e5;
}
.cc-acc-item {
  border-bottom:1px solid #e5e5e5;
}
.cc-acc-trigger {
  display:flex;
  align-items:center;
  justify-content:space-between;
  width:100%;
  padding:20px 0;
  background:none;
  border:none;
  cursor:pointer;
  font-family:'Inter', sans-serif;
  font-size:16px;
  font-weight:600;
  color:#1a1a1a;
}
.cc-acc-trigger svg { width:18px; height:18px; color:#888; transition:transform .3s; flex-shrink:0; }
.cc-acc-trigger.open svg { transform:rotate(90deg); }
.cc-acc-content {
  max-height:0;
  overflow:hidden;
  transition:max-height 0.4s cubic-bezier(0.16,1,0.3,1);
}
.cc-acc-inner {
  padding:0 0 20px;
  font-size:14px;
  font-weight:400;
  color:#555;
  line-height:1.8;
}
.cc-acc-inner p { margin:0 0 12px; }
.cc-acc-inner p:last-child { margin-bottom:0; }
.cc-acc-inner strong { color:#1a1a1a; }

/* Size chart table */
.cc-size-chart {
  width:100%;
  border-collapse:collapse;
  margin-top:12px;
  font-size:13px;
}
.cc-size-chart th {
  text-align:left;
  font-weight:600;
  padding:8px 12px;
  background:#f5f5f5;
  border:1px solid #e5e5e5;
}
.cc-size-chart td {
  padding:8px 12px;
  border:1px solid #e5e5e5;
}

/* ═══ Shared Section Heading ═══ */
.bp-section-heading {
  font-family:'Inter',sans-serif;
  font-size:13px;
  font-weight:700;
  letter-spacing:.18em;
  text-transform:uppercase;
  text-align:center;
  margin-bottom:40px;
  color:#1a1a1a;
  position:relative;
  padding-bottom:16px;
}
.bp-section-heading::after {
  content:'';
  position:absolute;
  bottom:0; left:50%; transform:translateX(-50%);
  width:40px; height:2px;
  background:#C4A265;
}
.bp-heading-light { color:#fff; }
.bp-heading-light::after { background:#C4A265; }

/* Brand Statement */
.bp-statement { text-align:center; padding:64px 24px; background:#FAFAF8; }
.bp-statement-inner { max-width:560px; margin:0 auto; }
.bp-statement-accent { width:40px; height:2px; background:#C4A265; margin:0 auto 24px; }
.bp-statement-title { font-family:'Inter',sans-serif; font-size:13px; font-weight:700; letter-spacing:.18em; text-transform:uppercase; margin-bottom:8px; color:#1a1a1a; }
.bp-statement-tagline { font-family:'Playfair Display',serif; font-size:22px; font-weight:400; line-height:1.3; margin-bottom:20px; color:#1a1a1a; }
.bp-statement-body { font-size:14px; font-weight:300; line-height:1.85; color:#666; }

/* Transformation Comparison */
.bp-transform { padding:64px 24px; text-align:center; background:#fff; }
.bp-transform-grid { display:grid; grid-template-columns:1fr; gap:16px; max-width:800px; margin:0 auto; }
.bp-transform-card { border-radius:16px; padding:32px 24px; text-align:left; }
.bp-transform-without { background:#FFF5F5; border:1px solid #FECACA; }
.bp-transform-with { background:#F0FDF4; border:1px solid #BBF7D0; }
.bp-transform-label { font-family:'Inter',sans-serif; font-size:11px; font-weight:700; letter-spacing:.15em; text-transform:uppercase; margin-bottom:24px; padding-bottom:12px; border-bottom:1px solid rgba(0,0,0,.08); color:#1a1a1a; }
.bp-transform-list { list-style:none; padding:0; margin:0; }
.bp-transform-list li { display:flex; align-items:flex-start; gap:12px; font-size:14px; font-weight:400; line-height:1.6; margin-bottom:14px; color:#444; }
.bp-transform-list li:last-child { margin-bottom:0; }
.bp-bullet { font-size:14px; font-weight:700; flex-shrink:0; width:22px; height:22px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:11px; margin-top:2px; }
.bp-bullet-x { background:rgba(220,38,38,.2); color:#EF4444; }
.bp-bullet-check { background:rgba(34,197,94,.2); color:#22C55E; }

/* Feature Grid */
.bp-features { padding:64px 24px; background:#FAFAF8; }
.bp-features-grid { display:grid; grid-template-columns:1fr; gap:12px; max-width:960px; margin:0 auto; }
.bp-feature-card { background:#fff; border:1px solid #E8E8E8; border-radius:16px; padding:32px 20px; text-align:left; transition:all .3s; }
.bp-feature-card:hover { border-color:#C4A265; transform:translateY(-4px); box-shadow:0 8px 24px rgba(0,0,0,.06); }
.bp-feature-num { font-family:'Inter',sans-serif; font-size:12px; font-weight:700; color:#C4A265; letter-spacing:.1em; margin-bottom:16px; }
.bp-feature-name { font-family:'Inter',sans-serif; font-size:15px; font-weight:600; margin-bottom:10px; color:#1a1a1a; }
.bp-feature-desc { font-size:13px; font-weight:300; color:#888; line-height:1.7; }

/* Ritual Steps */
.bp-ritual { padding:64px 24px; text-align:center; background:#FAFAF8; }
.bp-ritual-subtitle { font-size:14px; font-weight:300; color:#888; margin-bottom:40px; margin-top:-24px; }
.bp-ritual-steps { display:grid; grid-template-columns:1fr; gap:16px; max-width:900px; margin:0 auto; }
.bp-ritual-step { text-align:center; background:#fff; border-radius:20px; padding:40px 24px 32px; border:1px solid #E8E8E8; transition:box-shadow .3s; }
.bp-ritual-step:hover { box-shadow:0 8px 32px rgba(0,0,0,.06); }
.bp-ritual-circle { width:56px; height:56px; border-radius:50%; border:2px solid #C4A265; display:flex; align-items:center; justify-content:center; margin:0 auto 20px; font-family:'Inter',sans-serif; font-size:14px; font-weight:700; color:#C4A265; letter-spacing:.05em; }
.bp-ritual-step-title { font-family:'Inter',sans-serif; font-size:16px; font-weight:700; margin-bottom:10px; color:#1a1a1a; }
.bp-ritual-step-desc { font-size:13px; font-weight:300; color:#666; line-height:1.75; }

/* ═══ UGC Review Carousel ═══ */
.bp-ugc-section { padding:64px 0; background:#fff; overflow:hidden; }
.bp-ugc-section .bp-section-heading { padding:0 24px 16px; }
.bp-ugc-carousel { position:relative; width:100%; }
.bp-ugc-track { display:flex; gap:20px; animation:ugcScroll 40s linear infinite; padding:0 20px; }
.bp-ugc-track:hover { animation-play-state:paused; }
.bp-ugc-slide { flex-shrink:0; width:280px; }
.bp-ugc-img { width:280px; height:360px; border-radius:16px; overflow:hidden; margin-bottom:16px; }
.bp-ugc-img img { width:100%; height:100%; object-fit:cover; transition:transform .4s; }
.bp-ugc-slide:hover .bp-ugc-img img { transform:scale(1.05); }
.bp-ugc-review { padding:0 4px; }
.bp-ugc-stars { display:flex; gap:2px; margin-bottom:8px; }
.bp-ugc-stars svg { width:14px; height:14px; fill:#C4A265; }
.bp-ugc-text { font-size:13px; font-weight:300; font-style:italic; line-height:1.65; color:#444; margin-bottom:8px; }
.bp-ugc-author { font-size:12px; font-weight:600; color:#1a1a1a; letter-spacing:.04em; }
@keyframes ugcScroll {
  0% { transform:translateX(0); }
  100% { transform:translateX(-50%); }
}

/* FAQ */
.bp-faq { padding:64px 24px; background:#FAFAF8; }
.bp-faq-list { max-width:700px; margin:0 auto; }
.bp-faq-item { border-bottom:1px solid #E5E5E5; }
.bp-faq-item:first-child { border-top:1px solid #E5E5E5; }
.bp-faq-q { font-family:'Inter',sans-serif; font-size:15px; font-weight:600; color:#1a1a1a; padding:20px 0; cursor:pointer; list-style:none; display:flex; align-items:center; justify-content:space-between; }
.bp-faq-q::after { content:'+'; font-size:20px; font-weight:300; color:#999; transition:transform .3s; flex-shrink:0; margin-left:16px; }
.bp-faq-item[open] .bp-faq-q::after { content:'−'; }
.bp-faq-q::-webkit-details-marker { display:none; }
.bp-faq-a { font-size:14px; font-weight:300; color:#666; line-height:1.8; padding:0 0 20px; }

/* Dark CTA */
.bp-dark-cta { background:#1a1a1a; padding:72px 24px; text-align:center; }
.bp-dark-cta-label { font-family:'Inter',sans-serif; font-size:11px; font-weight:600; letter-spacing:.18em; text-transform:uppercase; color:#C4A265; margin-bottom:12px; }
.bp-dark-cta-text { font-size:16px; font-weight:300; color:rgba(255,255,255,.6); line-height:1.7; margin-bottom:32px; max-width:400px; margin-left:auto; margin-right:auto; }
.bp-dark-cta-btn { display:inline-block; background:linear-gradient(135deg,#C4A265,#D4B97A); color:#1a1a1a; font-family:'Inter',sans-serif; font-size:14px; font-weight:600; padding:16px 48px; border-radius:30px; border:none; cursor:pointer; transition:all .3s; letter-spacing:.04em; }
.bp-dark-cta-btn:hover { transform:translateY(-2px); box-shadow:0 8px 24px rgba(196,162,101,.3); }

/* Scroll Top */
.bp-scroll-top { position:fixed; bottom:80px; right:16px; width:44px; height:44px; background:#1a1a1a; color:#fff; border-radius:50%; display:flex; align-items:center; justify-content:center; cursor:pointer; border:none; box-shadow:0 4px 16px rgba(0,0,0,.15); transition:all .2s; z-index:99; }
.bp-scroll-top:hover { transform:scale(1.1); background:#C4A265; }
.bp-scroll-top svg { width:20px; height:20px; }

/* ═══════════════════════════════════════════════════
   RESPONSIVE BREAKPOINTS — ALL DEVICE SIZES
   ═══════════════════════════════════════════════════ */

/* ═══ BASE MOBILE-FIRST ═══ */
.cc-gallery-thumbs { display:none; }
.cc-gallery-col { flex-direction:column; }
.cc-gallery-main { max-height:75vh; }
.cc-gallery-slide img { max-height:75vh; object-fit:contain; }

/* ═══ SMALL MOBILE (≤374px) — iPhone SE, small Androids ═══ */
@media (max-width:374px) {
  .cc-product-page { padding:0 12px 40px; }
  .cc-product-title { font-size:22px; }
  .cc-sale-price { font-size:22px; }
  .cc-compare-price { font-size:18px; }
  .cc-color-swatch { width:70px; }
  .cc-swatch-img { width:70px; height:88px; }
  .cc-swatch-name { font-size:7px; }
  .cc-size-btn { min-width:44px; height:40px; padding:0 12px; font-size:13px; }
  .cc-atc-row { flex-direction:column; gap:8px; }
  .cc-qty-selector { width:100%; justify-content:center; }
  .cc-atc-btn { height:48px; font-size:14px; }
  .cc-meta-links { flex-wrap:wrap; gap:12px; }
  .bp-statement-tagline { font-size:18px; }
  .bp-transform-grid { grid-template-columns:1fr; gap:12px; }
  .bp-features-grid { grid-template-columns:1fr; gap:10px; }
  .bp-feature-card { padding:20px 16px; }
  .bp-ritual-steps { grid-template-columns:1fr; gap:12px; }
  .bp-ugc-slide { width:220px; }
  .bp-ugc-img { width:220px; height:280px; }
  .bp-dark-cta { padding:48px 16px; }
  .bp-dark-cta-btn { padding:14px 32px; font-size:13px; }
  .is-bundle-price { font-size:14px; }
  .is-bundle-sub { font-size:11px; }
  .is-sale-banner { font-size:9px; padding:7px 10px; gap:5px; }
  .is-fire { font-size:12px; }
  .is-cd-num { font-size:12px; padding:2px 4px; min-width:22px; }
  .is-cd-sep { font-size:10px; }
  .is-banner-label { font-size:9px; }
  .cc-product-page { max-width:100vw; overflow-x:hidden; }
}

/* ═══ MOBILE (375–479px) — iPhone 13/14/15, Pixel ═══ */
@media (min-width:375px) and (max-width:479px) {
  .cc-product-page { padding:0 16px 50px; }
  .cc-product-title { font-size:24px; }
  .cc-sale-price { font-size:24px; }
  .cc-compare-price { font-size:20px; }
  .cc-color-swatch { width:80px; }
  .cc-swatch-img { width:80px; height:100px; }
  .cc-swatch-name { font-size:8px; }
  .cc-size-btn { min-width:50px; height:42px; font-size:13px; }
  .cc-atc-row { flex-direction:row; gap:10px; }
  .bp-statement-title { font-size:22px; }
  .bp-features-grid { grid-template-columns:1fr 1fr; gap:8px; }
  .bp-feature-desc { font-size:11px; }
  .bp-testimonials-grid { gap:16px; }
  .is-sale-banner { font-size:10px; padding:8px 12px; gap:6px; }
  .is-fire { font-size:13px; }
  .is-cd-num { font-size:13px; padding:3px 5px; min-width:24px; }
