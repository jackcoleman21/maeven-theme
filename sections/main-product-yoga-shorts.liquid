</style>

<script>
(function() {
  /* ═══ Gallery Carousel ═══ */
  const galleryTrack = document.getElementById('ccGalleryTrack');
  const allSlides = galleryTrack ? Array.from(galleryTrack.querySelectorAll('.cc-gallery-slide')) : [];
  const prevBtn = document.getElementById('ccGalleryPrev');
  const nextBtn = document.getElementById('ccGalleryNext');
  const counterCurrent = document.getElementById('ccCurrentSlide');
  const counterTotal = document.getElementById('ccTotalSlides');
  const thumbContainer = document.getElementById('ccGalleryThumbs');
  let allThumbs = thumbContainer ? Array.from(thumbContainer.querySelectorAll('.cc-gallery-thumb')) : [];
  let filteredSlides = allSlides.slice();
  let filteredThumbs = allThumbs.slice();
  let currentIdx = 0;
  let totalSlides = allSlides.length;

  function goToSlide(idx, smooth) {
    if (totalSlides === 0) return;
    if (idx < 0) idx = totalSlides - 1;
    if (idx >= totalSlides) idx = 0;
    galleryTrack.style.transition = smooth !== false ? 'transform 0.4s cubic-bezier(0.25,0.1,0.25,1)' : 'none';
    galleryTrack.style.transform = 'translateX(-' + (idx * 100) + '%)';
    if (counterCurrent) counterCurrent.textContent = idx + 1;
    // Update thumbs
    filteredThumbs.forEach((t, i) => t.classList.toggle('active', i === idx));
    currentIdx = idx;
  }

  if (prevBtn) prevBtn.addEventListener('click', () => goToSlide(currentIdx - 1));
  if (nextBtn) nextBtn.addEventListener('click', () => goToSlide(currentIdx + 1));

  // Thumb clicks
  allThumbs.forEach((thumb, i) => {
    thumb.addEventListener('click', () => goToSlide(i));
  });

  // Touch swipe
  let touchStartX = 0, isDragging = false, dragOffset = 0;
  const galleryMain = document.getElementById('ccGalleryMain');
  if (galleryMain) {
    galleryMain.addEventListener('touchstart', e => {
      touchStartX = e.touches[0].clientX;
      isDragging = true;
      dragOffset = 0;
      galleryTrack.style.transition = 'none';
    }, { passive: true });
    galleryMain.addEventListener('touchmove', e => {
      if (!isDragging) return;
      dragOffset = e.touches[0].clientX - touchStartX;
      const base = -(currentIdx * 100);
      const pct = (dragOffset / galleryMain.offsetWidth) * 100;
      galleryTrack.style.transform = 'translateX(' + (base + pct) + '%)';
    }, { passive: true });
    galleryMain.addEventListener('touchend', () => {
      if (!isDragging) return;
      isDragging = false;
      const threshold = galleryMain.offsetWidth * 0.2;
      if (dragOffset < -threshold) goToSlide(currentIdx + 1);
      else if (dragOffset > threshold) goToSlide(currentIdx - 1);
      else goToSlide(currentIdx);
      dragOffset = 0;
    }, { passive: true });
  }

  /* ═══ Gallery Color Filtering ═══ */
  function filterGalleryByColor(colorName) {
    if (!galleryTrack || allSlides.length === 0) return;
    const cl = colorName.toLowerCase().trim();
    const matching = allSlides.filter(s => {
      const alt = (s.querySelector('img')?.alt || '').toLowerCase();
      return alt.includes(cl);
    });
    filteredSlides = matching.length > 0 ? matching : allSlides;
    filteredThumbs = matching.length > 0 ? allThumbs.filter((t, i) => {
      const alt = (allSlides[i]?.querySelector('img')?.alt || '').toLowerCase();
      return alt.includes(cl);
    }) : allThumbs;
    // Rebuild track
    galleryTrack.innerHTML = '';
    filteredSlides.forEach((s, i) => { s.setAttribute('data-index', i); galleryTrack.appendChild(s); });
    // Rebuild thumbs
    if (thumbContainer) {
      thumbContainer.innerHTML = '';
      filteredThumbs.forEach((t, i) => {
        t.classList.toggle('active', i === 0);
        t.onclick = () => goToSlide(i);
        thumbContainer.appendChild(t);
      });
    }
    totalSlides = filteredSlides.length;
    if (counterTotal) counterTotal.textContent = totalSlides;
    goToSlide(0, false);
  }

  /* ═══ Color Swatch Clicks ═══ */
  document.querySelectorAll('.cc-color-swatch').forEach(swatch => {
    swatch.addEventListener('click', function() {
      document.querySelectorAll('.cc-color-swatch').forEach(s => {
        s.classList.remove('active');
        s.querySelector('.cc-swatch-name')?.classList.remove('active');
      });
      this.classList.add('active');
      this.querySelector('.cc-swatch-name')?.classList.add('active');
      const color = this.dataset.color;
      // Update vendor text to color name
      const vendorEl = document.querySelector('.cc-vendor');
      if (vendorEl) vendorEl.textContent = color;
      // Filter gallery
      filterGalleryByColor(color);
      // Find the matching variant and update ATC state (handles OOS)
      updateVariantId();
      // On mobile, scroll up to the gallery so user sees the updated image
      if (window.innerWidth < 769) {
        const gallery = document.querySelector('.cc-gallery-col');
        if (gallery) gallery.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  /* ═══ Size Button Clicks ═══ */
  document.querySelectorAll('.cc-size-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.cc-size-btn').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      document.getElementById('ccSizeName').textContent = this.dataset.size;
      updateVariantId();
      if (typeof syncPairSizesWithMain === 'function') syncPairSizesWithMain(this.dataset.size);
    });
  });

  /* ═══ Find Correct Variant ID ═══ */
  const variantData = [
    {%- for variant in product.variants -%}
      { id: {{ variant.id }}, color: {{ variant.option1 | json }}, size: {{ variant.option2 | json }}, available: {{ variant.available }}, price: {{ variant.price }}, comparePrice: {{ variant.compare_at_price | default: 0 }} }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ];

  const oosColors = [{{ oos_colors | split: ',' | map: 'strip' | json }}].flat();

  function updateVariantId() {
    const activeColor = document.querySelector('.cc-color-swatch.active');
    const activeSize = document.querySelector('.cc-size-btn.active');
    if (!activeColor || !activeSize) return;
    const color = activeColor.dataset.color;
    const size = activeSize.dataset.size;
    const isOos = oosColors.includes(color);
    const match = variantData.find(v => v.color === color && v.size === size);
    if (match) {
      document.getElementById('cc-variant-id').value = match.id;
      // Also update dynamic checkout (Buy Now) form
      const dynForm = document.getElementById('cc-dynamic-checkout-form');
      if (dynForm) {
        const dynInput = dynForm.querySelector('input[name="id"]');
        if (dynInput) dynInput.value = match.id;
      }
      // Update price
      const saleEl = document.querySelector('.cc-sale-price');
      const compareEl = document.querySelector('.cc-compare-price');
      if (saleEl) saleEl.textContent = '$' + (match.price / 100).toFixed(2);
      if (compareEl && match.comparePrice > match.price) {
        compareEl.textContent = '$' + (match.comparePrice / 100).toFixed(2);
        compareEl.style.display = '';
      } else if (compareEl) {
        compareEl.style.display = 'none';
      }
      // Update discount badge
      const badge = document.querySelector('.cc-discount-badge');
      if (badge && match.comparePrice > match.price) {
        const pct = Math.round((1 - match.price / match.comparePrice) * 100);
        badge.textContent = '🔥 -' + pct + '%';
        badge.style.display = '';
      } else if (badge) {
        badge.style.display = 'none';
      }
      // Update ATC — check OOS override
      const realAvailable = match.available && !isOos;
      const atcBtn = document.getElementById('cc-atc-btn');
      if (atcBtn) {
        atcBtn.textContent = realAvailable ? 'Add to Cart' : 'Sold Out';
        atcBtn.disabled = !realAvailable;
      }
    }
  }

  /* ═══ Countdown Timer ═══ */
  const cdH = document.getElementById('isCdHours');
  const cdM = document.getElementById('isCdMins');
  const cdS = document.getElementById('isCdSecs');
  let prevSec = -1;
  function getEndOfDay() {
    const d = new Date(); d.setHours(23, 59, 59, 999); return d;
  }
  let cdEnd = getEndOfDay();
  function updateCountdown() {
    let diff = cdEnd - new Date();
    if (diff <= 0) { cdEnd = getEndOfDay(); diff = cdEnd - new Date(); }
    const h = Math.floor(diff / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    const s = Math.floor((diff % 60000) / 1000);
    if (cdH) cdH.textContent = String(h).padStart(2, '0');
    if (cdM) cdM.textContent = String(m).padStart(2, '0');
    if (cdS) {
      cdS.textContent = String(s).padStart(2, '0');
      if (s !== prevSec) {
        cdS.classList.remove('is-tick');
        void cdS.offsetWidth;
        cdS.classList.add('is-tick');
        prevSec = s;
      }
    }
  }
  updateCountdown();
  setInterval(updateCountdown, 1000);

  /* ═══ Bundle Selector ═══ */
  const qtyHidden = document.getElementById('cc-quantity');
  const dynCheckout = document.getElementById('cc-dynamic-checkout-form');

  function toggleDynamicCheckout(qty) {
    if (!dynCheckout) return;
    dynCheckout.style.display = (qty === '1' || qty === 1) ? '' : 'none';
  }

  document.querySelectorAll('.is-bundle-option').forEach(opt => {
    opt.addEventListener('click', function(e) {
      if (e.target.closest('.is-pair-thumb') || e.target.closest('.is-pair-toggle') || e.target.closest('.is-pair-size-chip')) return;
      document.querySelectorAll('.is-bundle-option').forEach(o => o.classList.remove('selected'));
      this.classList.add('selected');
      if (qtyHidden) qtyHidden.value = this.dataset.qty;
      toggleDynamicCheckout(this.dataset.qty);
    });
  });

  /* Init: sync quantity with pre-selected bundle */
  const initBundle = document.querySelector('.is-bundle-option.selected');
  if (initBundle && qtyHidden) {
    qtyHidden.value = initBundle.dataset.qty || '1';
    toggleDynamicCheckout(initBundle.dataset.qty || '1');
  }

  /* ═══ Per-pair thumbnail picker ═══ */
  document.querySelectorAll('.is-pair-thumb').forEach(thumb => {
    thumb.addEventListener('click', function(e) {
      e.stopPropagation();
      const row = this.closest('.is-pair-row');
      row.querySelectorAll('.is-pair-thumb').forEach(t => t.classList.remove('selected'));
      this.classList.add('selected');
      updateBundleSummary(this.closest('.is-bundle-option'));
    });
  });

  /* ═══ Per-pair size chip picker ═══ */
  document.querySelectorAll('.is-pair-size-chip').forEach(chip => {
    chip.addEventListener('click', function(e) {
      e.stopPropagation();
      const row = this.closest('.is-pair-row');
      row.querySelectorAll('.is-pair-size-chip').forEach(c => c.classList.remove('selected'));
      this.classList.add('selected');
      updateBundleSummary(this.closest('.is-bundle-option'));
    });
  });

  /* Toggle pair expanded/collapsed */
  document.querySelectorAll('.is-pair-toggle').forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      const bundle = this.closest('.is-bundle-option');
      const expanded = bundle.querySelector('.is-pair-expanded');
      const isOpen = expanded.classList.toggle('open');
      this.innerHTML = isOpen ? 'Done ↑' : 'Mix &amp; match ↓';
    });
  });

  /* Recompute summary line (color + size) */
  function updateBundleSummary(bundle) {
    if (!bundle) return;
    const summaryEl = bundle.querySelector('.is-pair-summary-text');
    if (!summaryEl) return;
    const rows = bundle.querySelectorAll('.is-pair-row');
    const colors = Array.from(rows).map(r => r.querySelector('.is-pair-thumb.selected')?.dataset.color).filter(Boolean);
    const sizes = Array.from(rows).map(r => r.querySelector('.is-pair-size-chip.selected')?.dataset.size).filter(Boolean);
    const uniqueColors = [...new Set(colors)];
    const uniqueSizes = [...new Set(sizes)];
    const checkSvg = '<span class="is-pair-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>';
    if (uniqueColors.length === 1 && uniqueSizes.length === 1) {
      summaryEl.innerHTML = checkSvg + '<span>All ' + colors.length + ' pairs in <strong class="is-pair-sync-color">' + uniqueColors[0] + '</strong> · Size ' + uniqueSizes[0] + '</span>';
    } else {
      summaryEl.innerHTML = checkSvg + '<span><strong>' + colors.length + ' pairs</strong> · Custom mix</span>';
    }
  }

  /* Sync pairs with main carousel color change */
  function syncPairsWithMain(newColor) {
    document.querySelectorAll('.is-bundle-option').forEach(bundle => {
      const rows = bundle.querySelectorAll('.is-pair-row');
      if (!rows.length) return;
      const colors = Array.from(rows).map(r => r.querySelector('.is-pair-thumb.selected')?.dataset.color);
      const allSame = colors.every(c => c === colors[0]);
      if (allSame) {
        rows.forEach(row => {
          row.querySelectorAll('.is-pair-thumb').forEach(t => {
            t.classList.toggle('selected', t.dataset.color === newColor);
          });
        });
        updateBundleSummary(bundle);
      }
    });
  }

  /* Sync pairs with main size selector change */
  let prevMainSize = document.querySelector('.cc-size-btn.active')?.dataset.size || 'XS';
  function syncPairSizesWithMain(newSize) {
    document.querySelectorAll('.is-bundle-option').forEach(bundle => {
      const rows = bundle.querySelectorAll('.is-pair-row');
      if (!rows.length) return;
      rows.forEach(row => {
        const currentChip = row.querySelector('.is-pair-size-chip.selected');
        if (currentChip && currentChip.dataset.size === prevMainSize) {
          row.querySelectorAll('.is-pair-size-chip').forEach(c => c.classList.remove('selected'));
          const target = row.querySelector('.is-pair-size-chip[data-size="' + newSize + '"]');
          if (target) target.classList.add('selected');
        }
      });
      updateBundleSummary(bundle);
    });
    prevMainSize = newSize;
  }

  /* Hook color swatch clicks to sync pairs */
  document.querySelectorAll('.cc-color-swatch').forEach(sw => {
    sw.addEventListener('click', () => syncPairsWithMain(sw.dataset.color));
  });

  /* ═══ ATC Form Submit ═══ */
  const form = document.getElementById('cc-product-form');
  if (form) {
    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      const btn = document.getElementById('cc-atc-btn');
      const origText = btn.textContent;
      btn.textContent = 'Adding...';
      btn.disabled = true;
      try {
        const vid = parseInt(document.getElementById('cc-variant-id').value);
        const activeTier = document.querySelector('.is-bundle-option.selected');
        const tierQty = activeTier ? parseInt(activeTier.dataset.qty) || 1 : 1;

        /* Build items array with per-pair variant support */
        let items = [];

        function getVariantId(color, size) {
          const match = variantData.find(v => v.color === color && v.size === size);
          return match ? match.id : vid;
        }

        function getPairVariants(bundleEl) {
          const pairRows = bundleEl.querySelectorAll('.is-pair-row');
          const variants = [];
          /* Read the main selector defaults */
          const mainColor = document.querySelector('.cc-color-swatch.active');
          const mainSize = document.querySelector('.cc-size-btn.active');
          const defaultColor = mainColor ? mainColor.dataset.color : '';
          const defaultSize = mainSize ? mainSize.dataset.size : '';

          if (pairRows.length > 0) {
            pairRows.forEach(row => {
              const selThumb = row.querySelector('.is-pair-thumb.selected');
              const selSize = row.querySelector('.is-pair-size-chip.selected');
              const pairColor = selThumb ? selThumb.dataset.color : defaultColor;
              const pairSize = selSize ? selSize.dataset.size : defaultSize;
              variants.push(getVariantId(pairColor, pairSize));
            });
          }
          return variants;
        }

        if (tierQty === 2) {
          /* 2-pair bundle */
          const pairVids = getPairVariants(activeTier);
          const vid1 = pairVids[0] || vid;
          const vid2 = pairVids[1] || vid;
          items = [
            { id: vid1, quantity: 1, properties: { _bundle: '2pack' } },
            { id: vid2, quantity: 1, properties: { _bundle: '2pack', _free: 'true' } }
          ];
        } else if (tierQty === 5) {
          /* 5-pack bundle */
          const pairVids = getPairVariants(activeTier);
          items = [];
          for (let i = 0; i < 5; i++) {
            const pv = pairVids[i] || vid;
            const isFree = i >= 3;
            items.push({
              id: pv,
              quantity: 1,
              properties: isFree
                ? { _bundle: '5pack', _free: 'true' }
                : { _bundle: '5pack' }
            });
          }
        } else {
          /* Buy 1 — single item, no bundle */
          items = [{ id: vid, quantity: 1 }];
        }

        await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: items })
        }).then(r => { if (!r.ok) throw new Error('Add failed'); return r.json(); });

        btn.textContent = 'Added ✓';
        btn.style.background = '#16A34A';
        await window.CartDrawer.refresh();
        window.CartDrawer.open();
        setTimeout(() => {
          btn.textContent = origText;
          btn.style.background = '#1a1a1a';
          btn.disabled = false;
        }, 2000);
      } catch(err) {
        console.error('ATC error:', err);
        btn.textContent = origText;
        btn.style.background = '#1a1a1a';
        btn.disabled = false;
      }
    });
  }

  /* ═══ Accordion Toggle ═══ */
  document.querySelectorAll('.cc-acc-trigger').forEach(trigger => {
    trigger.addEventListener('click', function() {
      const content = this.nextElementSibling;
      const isOpen = this.classList.contains('open');
      // Close all
      document.querySelectorAll('.cc-acc-trigger').forEach(t => {
        t.classList.remove('open');
        t.nextElementSibling.style.maxHeight = '0';
        // Reset icon to plus
        const svg = t.querySelector('svg');
        if (svg) svg.innerHTML = '<path d="M12 5v14M5 12h14"/>';
      });
      if (!isOpen) {
        this.classList.add('open');
        content.style.maxHeight = content.scrollHeight + 'px';
        // Set icon to minus
        const svg = this.querySelector('svg');
        if (svg) svg.innerHTML = '<path d="M5 12h14"/>';
      }
    });
  });

  /* ═══ Color Swatch Carousel Scroll ═══ */
  const swatchTrack = document.getElementById('ccSwatchTrack');
  document.getElementById('ccSwatchPrev')?.addEventListener('click', () => {
    swatchTrack.scrollBy({ left: -220, behavior: 'smooth' });
  });
  document.getElementById('ccSwatchNext')?.addEventListener('click', () => {
    swatchTrack.scrollBy({ left: 220, behavior: 'smooth' });
  });

  /* ═══ Initial Color Filter ═══ */
  const initialSwatch = document.querySelector('.cc-color-swatch.active');
  if (initialSwatch) {
    filterGalleryByColor(initialSwatch.dataset.color);
  }

  /* ═══ Stock Count Animation ═══ */
  let stockCount = 94;
  setInterval(() => {
    if (Math.random() > 0.7 && stockCount > 12) {
      stockCount--;
      const el = document.getElementById('ccStockCount');
      if (el) el.textContent = stockCount;
    }
  }, 15000);

  /* ═══ Load More Reviews ═══ */
  const loadMoreBtn = document.getElementById('bp-load-more');
  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', function() {
      const hidden = document.querySelectorAll('.bp-review-hidden');
      hidden.forEach(el => { el.classList.remove('bp-review-hidden'); el.classList.add('bp-review-reveal'); });
      this.style.display = 'none';
    });
  }

  /* ═══ UGC Carousel — duplicate slides for infinite scroll ═══ */
  const ugcTrack = document.getElementById('bpUgcTrack');
  if (ugcTrack) {
    const slides = ugcTrack.innerHTML;
    ugcTrack.innerHTML = slides + slides;
  }

  /* ═══ Scroll to Top Button ═══ */
  const scrollBtn = document.querySelector('.bp-scroll-top');
  if (scrollBtn) {
    scrollBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    window.addEventListener('scroll', () => { scrollBtn.style.opacity = window.scrollY > 600 ? '1' : '0'; scrollBtn.style.pointerEvents = window.scrollY > 600 ? 'auto' : 'none'; }, { passive: true });
    scrollBtn.style.opacity = '0';
    scrollBtn.style.pointerEvents = 'none';
    scrollBtn.style.transition = 'opacity .3s, transform .2s';
  }

})();
</script>

