{%- comment -%} Yoga Shorts Product Page — Bundle + Urgency {%- endcomment -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign oos_colors = '' -%}



<div class="cc-product-page">

<!-- Breadcrumb -->
<nav class="cc-breadcrumb">
  <a href="/">Home</a>
  <span class="cc-breadcrumb-sep">·</span>
  <span>{{ product.title }}</span>
</nav>

<!-- ═══ Main Product Row ═══ -->
<div class="cc-product-row">

<!-- ═══ Left: Gallery ═══ -->
<div class="cc-gallery-col">
  <div class="cc-gallery-thumbs" id="ccGalleryThumbs">
    {%- for image in product.images -%}
      <button class="cc-gallery-thumb{% if forloop.first %} active{% endif %}" data-thumb-index="{{ forloop.index0 }}">
        <img src="{{ image | image_url: width: 120 }}" alt="{{ image.alt | default: product.title }}" loading="lazy">
      </button>
    {%- endfor -%}
  </div>
  <div class="cc-gallery-main" id="ccGalleryMain">
    <div class="cc-gallery-track" id="ccGalleryTrack">
      {%- for image in product.images -%}
        <div class="cc-gallery-slide" data-index="{{ forloop.index0 }}">
          <img src="{{ image | image_url: width: 1200 }}" alt="{{ image.alt | default: product.title }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
        </div>
      {%- endfor -%}
    </div>
    <button class="cc-gallery-arrow cc-gallery-arrow--prev" id="ccGalleryPrev" aria-label="Previous image">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button class="cc-gallery-arrow cc-gallery-arrow--next" id="ccGalleryNext" aria-label="Next image">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 6 15 12 9 18"/></svg>
    </button>
    <div class="cc-gallery-counter" id="ccGalleryCounter">
      <span id="ccCurrentSlide">1</span> / <span id="ccTotalSlides">{{ product.images.size }}</span>
    </div>
  </div>
</div>

<!-- ═══ Right: Product Info ═══ -->
<div class="cc-info-col">

  <!-- Sale Countdown Badge -->
  <div class="is-sale-banner" id="isSaleBanner">
    <span class="is-fire">🔥</span>
    <span class="is-banner-label">Summer Sale Ends In</span>
    <span class="is-countdown">
      <span class="is-cd-num" id="isCdHours">00</span>
      <span class="is-cd-sep">:</span>
      <span class="is-cd-num" id="isCdMins">00</span>
      <span class="is-cd-sep">:</span>
      <span class="is-cd-num" id="isCdSecs">00</span>
    </span>
    <span class="is-fire">🔥</span>
  </div>

  <!-- Vendor -->
  <div class="cc-vendor">{{ current_variant.option1 | default: product.vendor }}</div>

  <!-- Title -->
  <h1 class="cc-product-title">{{ product.title }}</h1>

  <!-- Price -->
  <div class="cc-price-row">
    <span class="cc-sale-price">{{ current_variant.price | money }}</span>
    {%- if current_variant.compare_at_price > current_variant.price -%}
      <span class="cc-compare-price">{{ current_variant.compare_at_price | money }}</span>
    {%- endif -%}
  </div>

  <!-- ═══ Color Swatches (Image-based) ═══ -->
  <div class="cc-color-section">
    <div class="cc-color-label">SELECTED OPTION</div>
    <div class="cc-color-swatches-wrap">
      <button class="cc-swatch-arrow cc-swatch-arrow--prev" id="ccSwatchPrev" aria-label="Previous colors">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <div class="cc-color-swatches-track" id="ccSwatchTrack">
        {%- assign seen_colors = '' -%}
        {%- for variant in product.variants -%}
          {%- unless seen_colors contains variant.option1 -%}
            {%- assign seen_colors = seen_colors | append: variant.option1 | append: '|||' -%}
            {%- comment -%} Find the first product image matching this color {%- endcomment -%}
            {%- assign color_image = nil -%}
            {%- assign color_lower_find = variant.option1 | downcase -%}
            {%- for image in product.images -%}
              {%- assign alt_lower = image.alt | downcase -%}
              {%- if alt_lower contains color_lower_find -%}
                {%- unless color_image -%}
                  {%- assign color_image = image -%}
                {%- endunless -%}
              {%- endif -%}
            {%- endfor -%}
            {%- assign _is_oos = false -%}
            {%- assign _oos_arr = oos_colors | split: ',' -%}
            {%- for _oc in _oos_arr -%}
              {%- assign _oc_strip = _oc | strip -%}
              {%- if variant.option1 == _oc_strip -%}{%- assign _is_oos = true -%}{%- endif -%}
            {%- endfor -%}
            <button class="cc-color-swatch{% if variant.option1 == current_variant.option1 %} active{% endif %}{% if _is_oos %} oos{% endif %}"
                    data-color="{{ variant.option1 }}"
                    data-variant-id="{{ variant.id }}"
                    data-available="{% if _is_oos %}false{% else %}{{ variant.available }}{% endif %}"
                    type="button"
                    aria-label="{{ variant.option1 }}">
              <div class="cc-swatch-img">
                {%- if color_image -%}
                  <img src="{{ color_image | image_url: width: 200 }}" alt="{{ variant.option1 }}" loading="lazy">
                {%- else -%}
                  <div class="cc-swatch-placeholder"></div>
                {%- endif -%}
              </div>
              <span class="cc-swatch-name{% if variant.option1 == current_variant.option1 %} active{% endif %}">{{ variant.option1 | upcase | truncate: 10, '...' }}</span>
            </button>
          {%- endunless -%}
        {%- endfor -%}
      </div>
      <button class="cc-swatch-arrow cc-swatch-arrow--next" id="ccSwatchNext" aria-label="Next colors">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 6 15 12 9 18"/></svg>
      </button>
    </div>
  </div>

  <!-- ═══ Size Selector ═══ -->
  <div class="cc-size-section">
    <div class="cc-size-label">Size: <strong id="ccSizeName">{{ current_variant.option2 | default: 'XS' }}</strong></div>
    <div class="cc-size-options">
      {%- assign seen_sizes = '|' -%}
      {%- for variant in product.variants -%}
        {%- assign size_check = '|' | append: variant.option2 | append: '|' -%}
        {%- unless seen_sizes contains size_check -%}
          {%- assign seen_sizes = seen_sizes | append: variant.option2 | append: '|' -%}
          <button class="cc-size-btn{% if variant.option2 == current_variant.option2 %} active{% endif %}"
                  data-size="{{ variant.option2 }}"
                  type="button">{{ variant.option2 }}</button>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>



  <!-- ═══ Bundle Selector ═══ -->
  {%- comment -%} Build a list of unique colors with their swatch images for the pair picker {%- endcomment -%}
  {%- assign pair_colors = '' -%}
  {%- assign pair_images = '' -%}
  {%- assign seen_pair = '' -%}
  {%- for variant in product.variants -%}
    {%- unless seen_pair contains variant.option1 -%}
      {%- assign seen_pair = seen_pair | append: variant.option1 | append: '|||' -%}
      {%- assign color_img_url = '' -%}
      {%- assign col_lower = variant.option1 | downcase -%}
      {%- for image in product.images -%}
        {%- assign a_lower = image.alt | downcase -%}
        {%- if a_lower contains col_lower and color_img_url == '' -%}
          {%- assign color_img_url = image | image_url: width: 140 -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if pair_colors != '' -%}{%- assign pair_colors = pair_colors | append: '|||' -%}{%- assign pair_images = pair_images | append: '|||' -%}{%- endif -%}
      {%- assign pair_colors = pair_colors | append: variant.option1 -%}
      {%- assign pair_images = pair_images | append: color_img_url -%}
    {%- endunless -%}
  {%- endfor -%}
  {%- assign color_arr = pair_colors | split: '|||' -%}
  {%- assign img_arr = pair_images | split: '|||' -%}
  {%- assign active_color = current_variant.option1 -%}
  {%- assign active_size = current_variant.option2 | default: 'XS' -%}
  {%- assign size_list = '' -%}
  {%- assign seen_sz = '|' -%}
  {%- for variant in product.variants -%}
    {%- assign sz_check = '|' | append: variant.option2 | append: '|' -%}
    {%- unless seen_sz contains sz_check -%}
      {%- assign seen_sz = seen_sz | append: variant.option2 | append: '|' -%}
      {%- if size_list != '' -%}{%- assign size_list = size_list | append: '|||' -%}{%- endif -%}
      {%- assign size_list = size_list | append: variant.option2 -%}
    {%- endunless -%}
  {%- endfor -%}
  {%- assign size_arr = size_list | split: '|||' -%}

  {%- comment -%} Dynamic bundle pricing from product.price {%- endcomment -%}
  {%- assign unit_price_cents = current_variant.price -%}
  {%- assign unit_price_dollars = unit_price_cents | divided_by: 100.0 -%}
  {%- assign b1g1_total_cents = unit_price_cents -%}
  {%- assign b1g1_per_pair_cents = b1g1_total_cents | divided_by: 2 -%}
  {%- assign b3g2_total_cents = unit_price_cents | times: 3 -%}
  {%- assign b3g2_per_pair_cents = b3g2_total_cents | divided_by: 5 -%}

  <div class="is-bundle-selector" id="isBundleSelector">
    <!-- Tier 1: Buy 1 -->
    <div class="is-bundle-option" data-qty="1" data-total="{{ unit_price_cents | divided_by: 100.0 }}" data-pairs="1">
      <div class="is-bundle-top">
        <div class="is-bundle-radio"></div>
        <div class="is-bundle-info">
          <div class="is-bundle-title">1 PAIR</div>
          <div class="is-bundle-sub">Standard price</div>
        </div>
        <div class="is-bundle-price">{{ unit_price_cents | money }}</div>
      </div>
    </div>

    <!-- Tier 2: Buy 2 (pre-selected) -->
    <div class="is-bundle-option selected" data-qty="2" data-total="{{ b1g1_total_cents | divided_by: 100.0 }}" data-pairs="2">
      <div class="is-bundle-badge">MOST POPULAR</div>
      <div class="is-bundle-top">
        <div class="is-bundle-radio"></div>
        <div class="is-bundle-info">
          <div class="is-bundle-title">2 PAIRS</div>
          <div class="is-bundle-sub">2 pairs · {{ b1g1_per_pair_cents | money }} each</div>
        </div>
        <div class="is-bundle-price">{{ b1g1_total_cents | money }}</div>
      </div>
      <div class="is-bundle-pairs">
        <div class="is-pair-summary">
          <div class="is-pair-summary-text">
            <span class="is-pair-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            <span>All 2 pairs in <strong class="is-pair-sync-color">{{ active_color }}</strong> · Size {{ active_size }}</span>
          </div>
          <button class="is-pair-toggle" type="button">Mix &amp; match ↓</button>
        </div>
        <div class="is-pair-expanded">
          {%- for p in (1..2) -%}
          <div class="is-pair-row">
            <span class="is-pair-label">Pair {{ p }}</span>
            <div class="is-pair-thumbs">
              {%- for c in color_arr -%}
                {%- assign _pair_oos = false -%}
                {%- for _oc in _oos_arr -%}
                  {%- assign _oc_s = _oc | strip -%}
                  {%- if c == _oc_s -%}{%- assign _pair_oos = true -%}{%- endif -%}
                {%- endfor -%}
                {%- unless _pair_oos -%}
                <button class="is-pair-thumb{% if c == active_color %} selected{% endif %}" data-color="{{ c }}" type="button" aria-label="{{ c }}">
                  <img class="is-thumb-img" src="{{ img_arr[forloop.index0] }}" alt="{{ c }}" loading="lazy">
                  <div class="is-thumb-name">{{ c | truncate: 8, '...' | upcase }}</div>
                </button>
                {%- endunless -%}
              {%- endfor -%}
            </div>
            <div class="is-pair-sizes">
              {%- for sz in size_arr -%}
                <button class="is-pair-size-chip{% if sz == active_size %} selected{% endif %}" data-size="{{ sz }}" type="button">{{ sz }}</button>
              {%- endfor -%}
            </div>
          </div>
          {%- endfor -%}
        </div>
      </div>
    </div>

    <!-- Tier 3: Buy 5 -->
    <div class="is-bundle-option" data-qty="5" data-total="{{ b3g2_total_cents | divided_by: 100.0 }}" data-pairs="5">
      <div class="is-bundle-badge is-badge-value">BEST VALUE</div>
      <div class="is-bundle-top">
        <div class="is-bundle-radio"></div>
        <div class="is-bundle-info">
          <div class="is-bundle-title">5 PAIRS</div>
          <div class="is-bundle-sub">5 pairs · {{ b3g2_per_pair_cents | money }} each</div>
        </div>
        <div class="is-bundle-price">{{ b3g2_total_cents | money }}</div>
      </div>
      <div class="is-bundle-pairs">
        <div class="is-pair-summary">
          <div class="is-pair-summary-text">
            <span class="is-pair-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            <span>All 5 pairs in <strong class="is-pair-sync-color">{{ active_color }}</strong> · Size {{ active_size }}</span>
          </div>
          <button class="is-pair-toggle" type="button">Mix &amp; match ↓</button>
        </div>
        <div class="is-pair-expanded">
          {%- for p in (1..5) -%}
          <div class="is-pair-row">
            <span class="is-pair-label">Pair {{ p }}</span>
            <div class="is-pair-thumbs">
              {%- for c in color_arr -%}
                {%- assign _pair_oos = false -%}
                {%- for _oc in _oos_arr -%}
                  {%- assign _oc_s = _oc | strip -%}
                  {%- if c == _oc_s -%}{%- assign _pair_oos = true -%}{%- endif -%}
                {%- endfor -%}
                {%- unless _pair_oos -%}
                <button class="is-pair-thumb{% if c == active_color %} selected{% endif %}" data-color="{{ c }}" type="button" aria-label="{{ c }}">
                  <img class="is-thumb-img" src="{{ img_arr[forloop.index0] }}" alt="{{ c }}" loading="lazy">
                  <div class="is-thumb-name">{{ c | truncate: 8, '...' | upcase }}</div>
                </button>
                {%- endunless -%}
              {%- endfor -%}
            </div>
            <div class="is-pair-sizes">
              {%- for sz in size_arr -%}
                <button class="is-pair-size-chip{% if sz == active_size %} selected{% endif %}" data-size="{{ sz }}" type="button">{{ sz }}</button>
              {%- endfor -%}
            </div>
          </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ Add to Cart + Shop Pay + More ═══ -->
  <form method="post" action="/cart/add" id="cc-product-form" class="is-actions-stack">
    <input type="hidden" name="id" id="cc-variant-id" value="{{ current_variant.id }}">
    <input type="hidden" name="quantity" id="cc-quantity" value="2">
    <button type="submit" class="is-atc-btn" id="cc-atc-btn">Add to Cart</button>
  </form>
  {%- form 'product', product, id: 'cc-dynamic-checkout-form' -%}
    <input type="hidden" name="id" value="{{ current_variant.id }}">
    <div class="is-shopify-payment">
      {{ form | payment_button }}
    </div>
  {%- endform -%}

  <!-- Stock Warning -->
  <div class="cc-stock-msg" id="ccStockMsg">
    <svg viewBox="0 0 24 24" fill="none" stroke="#E53E3E" stroke-width="2" stroke-linecap="round"><path d="M12 9v4M12 17h.01"/><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
    Hurry up! Only <strong id="ccStockCount">94</strong> item(s) left in stock
  </div>

  <!-- Payment Trust Icons -->
  <div class="cc-trust-payments">
    {%- for type in shop.enabled_payment_types -%}
      {{ type | payment_type_svg_tag: class: 'cc-pay-icon' }}
    {%- endfor -%}
  </div>

  <!-- ═══ Frequently Bought Together ═══ -->
  {% render 'cross-sell', cross_handle_1: 'impact-shorts-4-5', cross_handle_2: 'impact-leggings' %}

  <!-- ═══ Description Accordion ═══ -->
  <div class="cc-accordions">
    <div class="cc-acc-item cc-acc-open">
      <button class="cc-acc-trigger" type="button">
        <span>Description</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/></svg>
      </button>
      <div class="cc-acc-content" style="max-height:600px">
        <div class="cc-acc-inner">
          <p><strong>Features</strong></p>
          <p>Seamless design | High stretch & durable fabric | Low ribbed band | Subtle glute contour | Incredibly soft feel | 4.5" leg length | 90% Nylon | 10% Elastane</p>
          <p><strong>Fit</strong> – Firm at True to Size. Size up for a more relaxed fit.</p>
          <p>Make your IMPACT in our 4.5" Shorts. Designed with subtle contouring and a scrunch seam to highlight your glute day pump. The low waistband structure gently dips down for ultimate comfort and core support while subtly highlighting the muscles you have worked so hard to build.</p>
          <p><strong>Care Instructions</strong></p>
          <p>Cool Wash Separately (30°C) | Cool Tumble Dry | Do Not Dry Clean or Bleach | Cool Iron</p>
        </div>
      </div>
    </div>
    <div class="cc-acc-item">
      <button class="cc-acc-trigger" type="button">
        <span>Shipping and Returns</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
      </button>
      <div class="cc-acc-content">
        <div class="cc-acc-inner">
          <p>We offer fast and reliable shipping on all orders. Once your order is placed, it will be processed and shipped as quickly as possible so you can start training in your new gear.</p>
          <p>Expedited shipping options may be available at checkout. If you have any questions about your order, don't hesitate to reach out to our support team.</p>
        </div>
      </div>
    </div>
    <div class="cc-acc-item">
      <button class="cc-acc-trigger" type="button">
        <span>Size Guide</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
      </button>
      <div class="cc-acc-content">
        <div class="cc-acc-inner">
          <p>Measure your natural waist (narrowest point) and hips (widest point around glutes). These yoga shorts run firm at true-to-size for a compression fit. If you fall between 2 sizes, size up for a more relaxed feel, or stay true-to-size for maximum hold and support.</p>
          <table class="cc-size-chart">
            <thead><tr><th>Size</th><th>US Size</th><th>Waist</th><th>Hips</th></tr></thead>
            <tbody>
              <tr><td>XS</td><td>0–2</td><td>24–25"</td><td>34–35"</td></tr>
              <tr><td>S</td><td>4–6</td><td>26–27"</td><td>36–37"</td></tr>
              <tr><td>M</td><td>8–10</td><td>28–29"</td><td>38–39"</td></tr>
              <tr><td>L</td><td>12–14</td><td>30–32"</td><td>40–42"</td></tr>
              <tr><td>XL</td><td>16–18</td><td>33–35"</td><td>43–45"</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

</div><!-- /cc-info-col -->
</div><!-- /cc-product-row -->

<!-- ═══ Full-width sections below ═══ -->

<!-- ═══ Brand Statement ═══ -->
<section class="bp-statement">
  <div class="bp-statement-inner">
    <div class="bp-statement-accent"></div>
    <h2 class="bp-statement-title">2-in-1 Yoga Shorts</h2>
    <p class="bp-statement-tagline">Flow. Stretch. Dominate. No Compromise.</p>
    <p class="bp-statement-body">Maeven™ 2-in-1 Yoga Shorts are designed for women who flow hard and want total coverage doing it. The built-in liner, super high waist, and hidden pockets mean you can move through any pose with zero distractions.</p>
  </div>
</section>

<!-- ═══ Transformation Comparison ═══ -->
<section class="bp-transform">
  <h2 class="bp-section-heading">The Transformation You'll See</h2>
  <div class="bp-transform-grid">
    <div class="bp-transform-card bp-transform-without">
      <div class="bp-transform-label">Without Maeven™</div>
      <ul class="bp-transform-list">
        <li><span class="bp-bullet bp-bullet-x">✕</span>Yoga shorts with zero pockets</li>
        <li><span class="bp-bullet bp-bullet-x">✕</span>See-through fabric during deep stretches</li>
        <li><span class="bp-bullet bp-bullet-x">✕</span>Low waistbands that roll during inversions</li>
        <li><span class="bp-bullet bp-bullet-x">✕</span>No liner coverage when you need it most</li>
      </ul>
    </div>
    <div class="bp-transform-card bp-transform-with">
      <div class="bp-transform-label">With Maeven™</div>
      <ul class="bp-transform-list">
        <li><span class="bp-bullet bp-bullet-check">✓</span>Super high waist that stays put through flows</li>
        <li><span class="bp-bullet bp-bullet-check">✓</span>Built-in liner, 100% coverage</li>
        <li><span class="bp-bullet bp-bullet-check">✓</span>Back pocket & side hidden pocket</li>
        <li><span class="bp-bullet bp-bullet-check">✓</span>Four-way stretch, buttery soft fabric</li>
      </ul>
    </div>
  </div>
</section>

<!-- ═══ Feature Grid ═══ -->
<section class="bp-features">
  <h2 class="bp-section-heading">Designed for Women Who Train</h2>
  <div class="bp-features-grid">
    <div class="bp-feature-card">
      <div class="bp-feature-num">01</div>
      <h3 class="bp-feature-name">2-in-1 Built-In Liner</h3>
      <p class="bp-feature-desc">Inner compression shorts provide full coverage during any pose — no more worrying about deep stretches or inversions.</p>
    </div>
    <div class="bp-feature-card">
      <div class="bp-feature-num">02</div>
      <h3 class="bp-feature-name">Hidden Pockets</h3>
      <p class="bp-feature-desc">Back waistband pocket for your card/key plus side hidden pocket for your phone. Secure and seamless — nothing bounces.</p>
    </div>
    <div class="bp-feature-card">
      <div class="bp-feature-num">03</div>
      <h3 class="bp-feature-name">Super High Waist</h3>
      <p class="bp-feature-desc">Tummy-smoothing high-rise band stays locked in through flows, folds, and inversions — zero rolling, zero adjusting.</p>
    </div>
    <div class="bp-feature-card">
      <div class="bp-feature-num">04</div>
      <h3 class="bp-feature-name">Four-Way Stretch</h3>
      <p class="bp-feature-desc">Premium single-sided brushed fabric moves with you in every direction. 75% Nylon 25% Elastane for the perfect balance.</p>
    </div>
    <div class="bp-feature-card">
      <div class="bp-feature-num">05</div>
      <h3 class="bp-feature-name">Buttery Soft Fabric</h3>
      <p class="bp-feature-desc">Single-sided brushed finish feels like butter on your skin. Sweat-wicking, breathable, and built for all-day comfort.</p>
    </div>
    <div class="bp-feature-card">
