    { "type": "text", "id": "review_count", "label": "Review count", "default": "1,892" },
    { "type": "text", "id": "avg_rating", "label": "Average rating", "default": "4.9" },
    { "type": "text", "id": "total_reviews", "label": "Total reviews label", "default": "50+" }
  ],
  "blocks": []
}
