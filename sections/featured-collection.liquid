<section class="collection-grid" id="featured-collection">
  <div class="container">
    <div class="collection-grid__header">
      <h2 class="collection-grid__title">{{ section.settings.heading }}</h2>
      {% if section.settings.collection %}
        <a href="{{ section.settings.collection.url }}" class="collection-grid__link">View All</a>
      {% endif %}
    </div>
    <div class="product-grid">
      {% if section.settings.collection %}
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <div class="product-card animate-in">
            <div class="product-card__media">
              {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="product-card__info">
              <h3 class="product-card__title"><a href="#">Sample Product {{ i }}</a></h3>
              <div class="product-card__price">
                <span class="product-card__price-regular">$29.99</span>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
